# ---------------------------------------------------------------------------
# RailSaathi environment variables
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# ---- Sarvam AI (used ONLY on the backend; never exposed to the browser) ----
# Get a key from https://dashboard.sarvam.ai (API Keys section).
SARVAM_API_KEY=your_sarvam_api_subscription_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# Speech-to-Text model. "saaras:v3" (default here) or "saaras:v4" (latest).
SARVAM_STT_MODEL=saaras:v3

# Text-to-Speech model. "bulbul:v3" is the API default; "bulbul:v2" is legacy.
SARVAM_TTS_MODEL=bulbul:v3
# One of the bulbul:v3 voices: shubh, aditya, ritu, priya, neha, rahul, kavya,
# anushka, simran, ishita, ... (see Sarvam docs for the full list).
SARVAM_TTS_SPEAKER=anushka

# Chat models. sarvam-105b = reasoning; sarvam-105b-conversations = low latency.
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_CHAT_MODEL_FAST=sarvam-105b-conversations

# Per-request timeout (seconds) for Sarvam and railway calls.
REQUEST_TIMEOUT=30

# ---- Railway data provider -------------------------------------------------
# "demo"  -> deterministic, clearly-labelled SIMULATED data (no key required)
# "http"  -> call a licensed/partner provider you are authorised to use
RAILWAY_PROVIDER=demo
RAILWAY_API_BASE=
RAILWAY_API_KEY=

# ---- App -------------------------------------------------------------------
APP_ENV=development
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
